# Deze variabelen worden automatisch ingesteld door Vercel
# wanneer je Upstash Redis vanuit de Vercel Marketplace toevoegt.
# Voor lokale ontwikkeling: `vercel env pull .env.development.local`

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optioneel: simpele gedeelde PIN voor het gezin.
# Niet ingevuld = iedereen met de URL kan bewerken (open toegang).
# Wel ingevuld = bij eerste bezoek wordt om de PIN gevraagd.
FAMILY_PIN=

# Optioneel: OpenRouteService API key voor nauwkeurigere routeberekening
# op de kaart. Niet ingevuld = publieke OSRM-server wordt gebruikt.
# Gratis key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Aanbevolen voor de "Ontdek de omgeving"-functie: Geoapify Places API key.
# De gratis publieke OpenStreetMap-servers (Overpass) weigeren Vercel's
# gedeelde IP-adressen vaak; Geoapify werkt wel betrouwbaar.
# Gratis key (3000 aanvragen/dag): https://www.geoapify.com/
GEOAPIFY_API_KEY=

# Nodig voor foto's bij de verblijven (/verblijven). Wordt automatisch gezet
# zodra je in het Vercel-dashboard onder Storage een Blob-store aan dit
# project koppelt. Zonder deze variabele werkt de hele pagina gewoon, alleen
# het uploaden van een foto geeft dan een nette foutmelding.
BLOB_READ_WRITE_TOKEN=
